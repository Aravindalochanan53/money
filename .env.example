# FlowCred Environment Configuration Example
# Copy this file to .env for local development

# Environment mode: 'development', 'test', or 'production'
ENVIRONMENT=development

# Project settings
PROJECT_NAME=FlowCred
API_V1_PREFIX=/api/v1

# Security & Authentication
# IMPORTANT: In production, SECRET_KEY must be a cryptographically secure random string.
# The server will refuse to start in production if this key is unset or set to a default value.
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_long_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# PostgreSQL is the default and supported production database.
DATABASE_URL=postgresql://flowcred:flowcred_dev_password@localhost:5432/flowcred

# Optional local test/fallback mode: SQLite (Uncomment below to use SQLite for offline testing)
# DATABASE_URL=sqlite:///./flowcred.db

# PostgreSQL Docker container settings (used by docker-compose)
POSTGRES_USER=flowcred
POSTGRES_PASSWORD=flowcred_dev_password
POSTGRES_DB=flowcred
POSTGRES_PORT=5432

# CORS Configuration - Explicit local development origins (JSON array string or comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Frontend API Configuration (used by Vite frontend)
VITE_API_BASE_URL=http://localhost:8000/api/v1
