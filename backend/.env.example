# FlowCred Backend Environment Configuration Example
ENVIRONMENT=development
PROJECT_NAME=FlowCred
API_V1_PREFIX=/api/v1
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_long_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql://flowcred:flowcred_dev_password@localhost:5432/flowcred
# Optional local test fallback:
# DATABASE_URL=sqlite:///./flowcred.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
